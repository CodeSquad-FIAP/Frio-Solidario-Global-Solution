<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nada do app vai para backup em nuvem nem para a transferência entre aparelhos. O
     único dado guardado é a sessão (token), que não deve sair do aparelho. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
